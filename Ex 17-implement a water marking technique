import cv2

image = cv2.imread(r"C:\Users\MADHUMITHA\OneDrive\Pictures\Screenshots\image.png\Image 2.png")

watermark = image.copy()

text = "WATERMARK"
position = (50, 50)

cv2.putText(watermark, text, position,
            cv2.FONT_HERSHEY_SIMPLEX, 1,
            (255, 255, 255), 2)

result = cv2.addWeighted(image, 0.7, watermark, 0.3, 0)

cv2.imshow("Original Image", image)
cv2.imshow("Watermarked Image", result)

cv2.imwrite("watermarked_image.jpg", result)

cv2.waitKey(0)
cv2.destroyAllWindows()
